# Twitch OAuth & Application Credentials
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here
TWITCH_CHANNEL=your_streamer_channel_name

# Local Auth Server Configuration
PORT=3000
REDIRECT_URI=https://localhost:3000
SCOPES=user:read:chat user:write:chat chat:read chat:edit

TTS_ALL_MESSAGES=true

# Selección de voces neuronales (EdgeTTS)
VOICE_FEMALE=es-MX-DaliaNeural
VOICE_MALE=es-MX-JorgeNeural
VOICE_DEFAULT=es-US-PalomaNeural

# Spotify Web API Credentials
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
